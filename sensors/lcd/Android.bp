cc_library_static {
    name: "sensors.xiaomi.lid-state-tracker",
    defaults: ["hidl_defaults"],
    srcs: ["LidStateTracker.cpp"],
    shared_libs: [
        "liblog",
    ],
    export_include_dirs: ["."],
    vendor: true,
}

cc_library_shared {
    name: "sensors.xiaomi.lcd.v2",
    defaults: ["hidl_defaults"],
    srcs: [
        ":xiaomi_sensors_v2_base_srcs",
        "LidStateTracker.cpp",
        "SensorsSubHal.cpp",
    ],
    shared_libs: [
        "android.hardware.sensors@1.0",
        "android.hardware.sensors@2.0",
        "android.hardware.sensors@2.0-ScopedWakelock",
        "android.hardware.sensors@2.1",
        "libcutils",
        "libfmq",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libpower",
        "libutils",
    ],
    static_libs: [
        "android.hardware.sensors@1.0-convert",
        "android.hardware.sensors@2.X-multihal",
    ],
    cflags: [
        "-DLOG_TAG=\"sensors.xiaomi.lcd\"",
    ],
    vendor: true,
}
